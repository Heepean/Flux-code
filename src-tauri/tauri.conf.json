{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux Hands",
  "version": "1.0.5",
  "identifier": "dev.fluxcode.fluxhands",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flux Hands — AI Development Studio",
        "width": 1500,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2OUJEQURDQzcwNjNFQkYKUldTL1BnYkgzTnFiMWtYU0VyRFJMNTF0Sm5GTDJhME1BUUVSMnJIZjFoSzBmZ3IvWmYvRmZZTi8K",
      "endpoints": [
        "https://github.com/Heepean/Flux-code/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
